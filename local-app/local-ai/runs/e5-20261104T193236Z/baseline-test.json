  "predictions": [
    {
      "id": "e01971cbc5e5",
      "text": "Пока дошёл до стола, оказалось, что обед уже совсем остыл.",
      "label": "temperature",
      "label_id": 0,
      "language": "ru",
      "source": "assistant_authored_synthetic_final_audit",
      "split": "test",
