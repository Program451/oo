      "label_id": 2,
      "language": "kk",
      "source": "assistant_authored_synthetic_final_audit",
      "split": "test",
      "prediction": "portion",
      "correct": true
    },
    {
      "id": "cb9bcca48638",
      "text": "Кезекке шағым жоқ, маған қосымша тамақ керек болды.",
      "label": "portion",
      "label_id": 2,
      "language": "kk",
